<!-- TreatAsLocalProperty="StrideSkipAutoPack": see Stride.Templates.Games.csproj's own comment —
     same reasoning applies here. -->
<!-- TargetFramework is set, then Sdk.props imported explicitly (not via the Project Sdk=
     attribute): see Stride.Templates.Games.csproj's own comment for why the ordering matters. -->
<Project TreatAsLocalProperty="StrideSkipAutoPack">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- Imported before the PropertyGroup below (not after): PackageVersion's own default there
       reads $(PVXInformationalVersion), which this import defines. -->
  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), 'Directory.Build.props'))/pvx/PVX.Version.props" />
  <Import Project="Sdk.props" Sdk="Microsoft.Build.NoTargets" />

  <PropertyGroup>
    <PackageId>PVX.Templates.Games</PackageId>
    <Title>PVX Game Templates</Title>
    <Description>dotnet new starters for creating a new PVX game (PVX Engine, built on Stride): a blank game and a psychological-horror foundation.</Description>
    <PackageTags>dotnet-new;templates;pvx;pvx-template;gamedev</PackageTags>
    <!-- PVX templates follow PVX's own version line (PVX.Version.props), not Stride's — see
         PVXTemplatesAppendPvxVersionArg below, which also stamps $PvxVersion$/PVX.* references
         into the packed content with this same value. -->
    <PackageVersion Condition="'$(PackageVersion)' == ''">$(PVXInformationalVersion)</PackageVersion>
  </PropertyGroup>

  <Import Project="..\..\..\templates\Stride.Templates.Common.targets" />

  <ItemGroup>
    <StrideSampleTemplate Include="pvx-game">
      <SamplePath>$(StrideRoot)samples/Templates/PvxGame/PvxGame</SamplePath>
    </StrideSampleTemplate>
    <StrideSampleTemplate Include="pvx-psychological-horror">
      <SamplePath>$(StrideRoot)samples/Templates/PvxPsychologicalHorror/PvxPsychologicalHorror</SamplePath>
    </StrideSampleTemplate>
  </ItemGroup>

  <!-- Static literal-wildcard inputs so a sample edit triggers a repack (CPS needs pre-expanded
       paths; see Stride.Templates.Common.targets). One per StrideSampleTemplate above. -->
  <ItemGroup>
    <UpToDateCheckInput Include="$(StrideRoot)samples/Templates/PvxGame/PvxGame/**/*" />
    <UpToDateCheckInput Include="$(StrideRoot)samples/Templates/PvxPsychologicalHorror/PvxPsychologicalHorror/**/*" />
  </ItemGroup>

  <!-- PVX's own version stamp, via the opt-in extension point Stride.Templates.Common.targets
       exposes ($(StrideTemplatesExtraPreprocessArgs), empty by default for Stride's own
       packages): stamps $PvxVersion$ literals and PVX.* PackageReference versions, parallel to
       the engine-version option for Stride.* (see TemplatePreprocessor.PvxVersion/SubstitutePvxVersion). -->
  <Target Name="PVXTemplatesAppendPvxVersionArg" BeforeTargets="StrideGenerateTemplateContent">
    <PropertyGroup>
      <StrideTemplatesExtraPreprocessArgs>$(StrideTemplatesExtraPreprocessArgs) --pvx-version=&quot;$(PVXInformationalVersion)&quot;</StrideTemplatesExtraPreprocessArgs>
    </PropertyGroup>
  </Target>
  <Import Project="Sdk.targets" Sdk="Microsoft.Build.NoTargets" />
</Project>
